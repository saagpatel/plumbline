{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plumbline.dev/schema/0.3.0/outcome-bound-trajectory.schema.json",
  "title": "OutcomeBoundTrajectoryV1",
  "description": "A metadata-only companion envelope binding a Plumbline trace digest to capability observations and independently attributable outcomes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trajectory_id",
    "created_at",
    "task",
    "trace",
    "capability_usage_snapshot",
    "capabilities",
    "outcomes",
    "indicators",
    "privacy",
    "lifecycle",
    "schema_evolution",
    "claim"
  ],
  "properties": {
    "schema_version": {"const": "OutcomeBoundTrajectoryV1"},
    "trajectory_id": {"$ref": "#/$defs/metadataId"},
    "created_at": {"type": "string", "format": "date-time"},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "identity_kind", "execution_id"],
      "properties": {
        "task_id": {"$ref": "#/$defs/metadataId"},
        "identity_kind": {"const": "pseudonymous"},
        "execution_id": {"$ref": "#/$defs/metadataId"}
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "digest", "schema_version"],
      "properties": {
        "run_id": {"$ref": "#/$defs/metadataId"},
        "digest": {"$ref": "#/$defs/digest"},
        "schema_version": {"$ref": "#/$defs/metadataId"}
      }
    },
    "capability_usage_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "digest", "generated_at", "as_of", "claim_ceiling"],
      "properties": {
        "schema": {"const": "CodexCapabilityUsageSnapshotV1"},
        "digest": {"$ref": "#/$defs/digest"},
        "generated_at": {"type": "string", "format": "date-time"},
        "as_of": {"type": "string", "format": "date-time"},
        "claim_ceiling": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/capability"}
    },
    "outcomes": {
      "type": "array",
      "items": {"$ref": "#/$defs/outcome"}
    },
    "indicators": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_ms",
        "rework_count",
        "error_count",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "cost_usd"
      ],
      "properties": {
        "duration_ms": {"type": "integer", "minimum": 0},
        "rework_count": {"type": "integer", "minimum": 0},
        "error_count": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cost_usd": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "raw_prompts_included",
        "full_tool_payloads_included",
        "secret_material_included",
        "redaction_state",
        "authorization_audience",
        "verification"
      ],
      "properties": {
        "profile": {"const": "metadata-only-v1"},
        "raw_prompts_included": {"const": false},
        "full_tool_payloads_included": {"const": false},
        "secret_material_included": {"const": false},
        "redaction_state": {"enum": ["not-required", "scrubbed", "verified-synthetic"]},
        "authorization_audience": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/metadataRef"}
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verifier", "ruleset", "receipt_ref", "receipt_digest", "verified_at"],
          "properties": {
            "verifier": {"$ref": "#/$defs/metadataId"},
            "ruleset": {"$ref": "#/$defs/metadataId"},
            "receipt_ref": {"$ref": "#/$defs/metadataRef"},
            "receipt_digest": {"$ref": "#/$defs/digest"},
            "verified_at": {"type": "string", "format": "date-time"}
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retention_days", "expires_at", "deletion_mode"],
      "properties": {
        "retention_days": {"type": "integer", "minimum": 1},
        "expires_at": {"type": "string", "format": "date-time"},
        "deletion_mode": {
          "enum": ["delete-envelope", "delete-envelope-and-private-source"]
        }
      }
    },
    "schema_evolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "producer_version", "compatible_with"],
      "properties": {
        "producer": {"$ref": "#/$defs/metadataId"},
        "producer_version": {"$ref": "#/$defs/metadataId"},
        "compatible_with": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/metadataRef"}
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "ceiling", "basis_refs"],
      "properties": {
        "state": {"enum": ["observation", "correlation", "experiment", "causality"]},
        "ceiling": {"type": "string", "minLength": 1, "maxLength": 512},
        "basis_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/metadataRef"}
        },
        "experimental_design_ref": {"$ref": "#/$defs/metadataRef"}
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "metadataId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,127}$"
    },
    "metadataRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#@+\\-]{0,255}$"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "kind",
        "state",
        "observed_at",
        "evidence_refs",
        "span_refs",
        "outcome_refs",
        "provenance",
        "confidence"
      ],
      "properties": {
        "capability_id": {"$ref": "#/$defs/metadataId"},
        "kind": {"enum": ["agent", "harness", "mcp", "role", "skill", "tool"]},
        "state": {"enum": ["available", "exposed", "adopted"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "evidence_refs": {"$ref": "#/$defs/refs"},
        "span_refs": {"$ref": "#/$defs/refs"},
        "outcome_refs": {"$ref": "#/$defs/refs"},
        "provenance": {"$ref": "#/$defs/metadataId"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_id",
        "label",
        "status",
        "source_type",
        "source_digest",
        "source_ref",
        "authority",
        "observed_at",
        "confidence",
        "independent"
      ],
      "properties": {
        "outcome_id": {"$ref": "#/$defs/metadataId"},
        "label": {"$ref": "#/$defs/metadataId"},
        "status": {"enum": ["aborted", "failed", "passed", "unknown"]},
        "source_type": {"$ref": "#/$defs/metadataId"},
        "source_digest": {"$ref": "#/$defs/digest"},
        "source_ref": {"$ref": "#/$defs/metadataRef"},
        "authority": {"$ref": "#/$defs/metadataId"},
        "observed_at": {"type": "string", "format": "date-time"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "independent": {"type": "boolean"}
      }
    },
    "refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/metadataRef"}
    }
  }
}
